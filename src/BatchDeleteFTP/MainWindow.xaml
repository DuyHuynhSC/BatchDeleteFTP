<Window x:Class="BatchDeleteFTP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="BatchDeleteFTP - Quản lý Xóa &amp; Backup File FTP (Implicit/Explicit TLS)"
        Height="800" Width="1120" MinHeight="700" MinWidth="980"
        Icon="pack://application:,,,/BatchDeleteFTP;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="165"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER & PROFILE BAR -->
        <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Padding="16,10" materialDesign:ElevationAssist.Elevation="Dp4">
            <DockPanel>
                <!-- App Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CloudSyncOutline" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BatchDeleteFTP" FontSize="17" FontWeight="Bold" LineHeight="20"/>
                        <TextBlock Text="Quản lý Tự động Backup &amp; Xóa File FTP theo Ngày" FontSize="11" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>

                <!-- Theme Switcher (Right) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Background="#22FFFFFF" CornerRadius="16" Padding="10,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon x:Name="IconThemeMode" Kind="WeatherSunny" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtThemeMode" Text="Light" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ToggleButton x:Name="TglDarkTheme"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="Chuyển đổi giao diện Sáng / Tối (Dark / Light Theme)"
                                          Checked="TglDarkTheme_Changed"
                                          Unchecked="TglDarkTheme_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Profile Manager (Center-Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource MaterialDesignPaper}"
                            TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                            CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.75"/>
                            <TextBlock Text="Site Profile:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="CboProfiles" Width="210" IsEditable="True"
                                      VerticalContentAlignment="Center"
                                      materialDesign:HintAssist.Hint="Chọn hoặc nhập tên Site..."
                                      SelectionChanged="CboProfiles_SelectionChanged"
                                      ToolTip="Chọn Site/Profile đã lưu hoặc nhập tên Profile mới"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnNewProfile" Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Height="32" Padding="10,0" Margin="0,0,6,0" Click="BtnNewProfile_Click"
                            ToolTip="Khởi tạo một Profile mới">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Tạo Mới" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveProfile" Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Height="32" Padding="10,0" Margin="0,0,6,0" Click="BtnSaveProfile_Click"
                            ToolTip="Lưu thông tin kết nối vào Profile đang chọn/nhập">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu Profile" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteProfile" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#C62828" BorderBrush="#C62828" Foreground="White"
                            Height="32" Padding="10,0" Click="BtnDeleteProfile_Click"
                            ToolTip="Xóa Profile đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Xóa" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- SECTION 1: CONFIGURATION CARD -->
        <materialDesign:Card Grid.Row="1" Margin="14,12,14,8" Padding="16,12" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <!-- Card Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="TuneVariant" Width="20" Height="20" VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="1. Cấu hình Kết nối FTP, Proxy &amp; Backup" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row A: FTP Server, Port, Encryption, User, Password, Retention Days -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtHost" Grid.Column="0" Margin="0,0,12,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="FTP Host (VD: ftp.xxx.net)"
                             VerticalContentAlignment="Center"/>

                    <TextBox x:Name="TxtPort" Grid.Column="1" Margin="0,0,12,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Port (6021)"
                             VerticalContentAlignment="Center"/>

                    <ComboBox x:Name="CboEncryption" Grid.Column="2" Margin="0,0,12,0" SelectedIndex="0"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              materialDesign:HintAssist.Hint="Phương thức Mã hóa (TLS)"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Implicit (FTP over TLS)" Tag="Implicit"/>
                        <ComboBoxItem Content="Explicit (FTP over TLS)" Tag="Explicit"/>
                    </ComboBox>

                    <TextBox x:Name="TxtUser" Grid.Column="3" Margin="0,0,12,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="FTP Username"
                             VerticalContentAlignment="Center"/>

                    <PasswordBox x:Name="TxtPassword" Grid.Column="4" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 materialDesign:HintAssist.Hint="FTP Password"
                                 VerticalContentAlignment="Center"/>

                    <TextBox x:Name="TxtRetentionDays" Grid.Column="5"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Giữ lại (+N ngày)"
                             ToolTip="Xóa các file có SystemDate.Date &gt; UploadDate.Date + N"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <Separator Opacity="0.25" Margin="0,2,0,8"/>

                <!-- Row B: Proxy Configuration -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkUseProxy" Grid.Column="0" Content="Sử dụng Proxy"
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <Grid Grid.Column="1" IsEnabled="{Binding ElementName=ChkUseProxy, Path=IsChecked}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtProxyHost" Grid.Column="0" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Địa chỉ Proxy Server"
                                 ToolTip="Địa chỉ Proxy Server"/>

                        <TextBox x:Name="TxtProxyPort" Grid.Column="1" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Proxy Port"
                                 ToolTip="Cổng Proxy"/>

                        <TextBox x:Name="TxtProxyUser" Grid.Column="2" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Proxy User (nếu có)"
                                 ToolTip="Tên đăng nhập Proxy (nếu có)"/>

                        <PasswordBox x:Name="TxtProxyPassword" Grid.Column="3"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     materialDesign:HintAssist.Hint="Proxy Password"
                                     ToolTip="Mật khẩu Proxy (nếu có)"/>
                    </Grid>
                </Grid>

                <Separator Opacity="0.25" Margin="0,2,0,8"/>

                <!-- Row C: Remote Paths & Local Backup -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FolderNetworkOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.75"/>
                        <TextBlock Text="Remote Paths (;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="BtnBrowseRemote" DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="10,0" Margin="8,0,0,0"
                                Click="BtnBrowseRemote_Click"
                                ToolTip="Duyệt cây thư mục trực tiếp trên FTP Server">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chọn FTP..." VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TxtRemotePaths"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Nhiều thư mục cách nhau bởi dấu ; (VD: /FolderA;/FolderB)"
                                 ToolTip="Nhiều đường dẫn ngăn cách bởi dấu chấm phẩy (;), ví dụ: /FolderA;/FolderB"/>
                    </DockPanel>

                    <CheckBox x:Name="ChkEnableBackup" Grid.Column="3" Content="Backup trước xóa"
                              VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <DockPanel Grid.Column="4" VerticalAlignment="Center"
                               IsEnabled="{Binding ElementName=ChkEnableBackup, Path=IsChecked}">
                        <Button x:Name="BtnBrowseLocalBackup" DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="32" Padding="10,0" Margin="8,0,0,0"
                                Click="BtnBrowseLocalBackup_Click"
                                ToolTip="Chọn thư mục lưu bản sao lưu trên máy tính">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chọn Local..." VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TxtLocalBackupPath"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Thư mục lưu Backup trên máy tính"/>
                    </DockPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- SECTION 2: ACTION TOOLBAR -->
        <Grid Grid.Row="2" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnSaveConfig" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="14,0" Margin="0,0,10,0" Click="BtnSaveConfig_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Lưu Cấu Hình" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTestConnection" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="36" Padding="14,0" Margin="0,0,10,0" Click="BtnTestConnection_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTestConnectionLabel" Text="Kiểm Tra Kết Nối" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPreview" Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36" Padding="16,0" Margin="0,0,10,0" Click="BtnPreview_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileSearchOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Xem Trước (Preview)" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExecuteDelete" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White"
                            Height="36" Padding="16,0" Click="BtnExecuteDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thực Hiện Backup &amp; Xóa" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnSelectAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMultipleMarkedOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Chọn tất cả" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Click="BtnUnselectAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Bỏ chọn tất cả" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <ProgressBar x:Name="BusyProgressBar" Grid.Row="1" IsIndeterminate="True"
                         Visibility="Collapsed" Height="3" Margin="0,6,0,0"/>
        </Grid>

        <!-- SECTION 3: CANDIDATE FILES DATAGRID CARD -->
        <materialDesign:Card Grid.Row="3" Margin="14,0,14,8" Padding="14,10" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="2. Danh sách File Thỏa Điều Kiện Xóa (SystemDate.Date &gt; UploadDate.Date + N)"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="GridCandidates" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" SelectionUnit="FullRow"
                           GridLinesVisibility="Horizontal"
                          BorderThickness="1" BorderBrush="#22888888">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Chọn xóa" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Đường dẫn FTP (Remote Path)" Binding="{Binding FullPath}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ngày Upload (Modified)" Binding="{Binding ModifiedDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Dung lượng (Bytes)" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="145" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="190" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- SECTION 4: ACTIVITY LOG CARD -->
        <materialDesign:Card Grid.Row="4" Margin="14,0,14,12" Padding="14,8" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Console" Width="18" Height="18"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="3. Nhật ký hoạt động (Activity Log)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="24" Padding="8,0" Click="BtnClearLog_Click"
                            ToolTip="Xóa nội dung nhật ký trên màn hình">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EraserVariant" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Xóa Log" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="6" Padding="6">
                    <TextBox x:Name="TxtLogs" IsReadOnly="True"
                             BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             Background="Transparent" Foreground="#D4D4D4"/>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
