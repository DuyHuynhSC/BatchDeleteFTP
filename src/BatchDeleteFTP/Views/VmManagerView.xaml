<UserControl x:Class="BatchDeleteFTP.Views.VmManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,0,0,10" Padding="12,10">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons (Left) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- NÚT PLAY CHÍNH TRÊN TOOLBAR -->
                    <Button x:Name="BtnToolbarPlay" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="32" Padding="14,0" Margin="0,0,8,0" Click="BtnToolbarPlay_Click"
                            ToolTip="Mở Remote Desktop kết nối ngay tới máy ảo đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Play (Mở RDP)" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAddVm" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnAddVm_Click"
                            ToolTip="Thêm máy ảo mới vào danh sách">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm Máy Ảo" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnImportExcel" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnImportExcel_Click"
                            ToolTip="Nhập danh sách máy ảo từ file Excel (.xlsx / .xls)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import Excel" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDownloadTemplate" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnDownloadTemplate_Click"
                            ToolTip="Xuất file mẫu Excel để nhập liệu">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDownloadOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="File Mẫu" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRefresh" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnRefresh_Click"
                            ToolTip="Tải lại danh sách từ bộ nhớ">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Search Box (Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Grid.Column="0"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tìm IP, tên máy, OS, DB, người KT..."
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     BorderThickness="0" VerticalAlignment="Center" FontSize="12"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                    Visibility="Collapsed" Click="BtnClearSearch_Click">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14"
                                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN DATAGRID -->
        <materialDesign:Card Grid.Row="1" Padding="6">
            <DataGrid x:Name="GridVms" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      Background="{DynamicResource AppCardBackgroundBrush}"
                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="GridVms_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- PLAY (CONNECT RDP) BUTTON -->
                    <DataGridTemplateColumn Header="Play" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AppSuccessButtonStyle}"
                                        Width="78" Height="28" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="BtnPlayRdp_Click"
                                        ToolTip="Mở Remote Desktop (Play)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Play" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="STT" Binding="{Binding No}" Width="55"/>

                    <!-- IP WITH COPY BUTTON -->
                    <DataGridTemplateColumn Header="Địa Chỉ IP" Width="Auto" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            DockPanel.Dock="Right" Width="22" Height="22" Padding="0"
                                            Click="BtnCopyIp_Click" ToolTip="Sao chép IP">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                                 Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    </Button>
                                    <TextBlock Text="{Binding Ip}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tên Máy" Binding="{Binding MachineName}" Width="Auto" MinWidth="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Domain/Workgroup" Binding="{Binding DomainOrWorkgroup}" Width="Auto" MinWidth="145"/>
                    <DataGridTextColumn Header="Hệ Điều Hành" Binding="{Binding Os}" Width="Auto" MinWidth="240"/>
                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="Auto" MinWidth="110"/>

                    <!-- PASSWORD WITH MASK TOGGLE & COPY -->
                    <DataGridTemplateColumn Header="Password" Width="Auto" MinWidth="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0" Margin="2,0"
                                                Click="BtnTogglePassword_Click" ToolTip="Ẩn / Hiện mật khẩu">
                                            <materialDesign:PackIcon Kind="{Binding IsPasswordMasked, Converter={x:Null}, FallbackValue=EyeOutline}"
                                                                     Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="BtnCopyPass_Click" ToolTip="Sao chép Password">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPassword}" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TNS" Binding="{Binding Tns}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Database Name" Binding="{Binding DatabaseName}" Width="Auto" MinWidth="135"/>
                    <DataGridTextColumn Header="Oracle Ver" Binding="{Binding OracleVersion}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Người KT" Binding="{Binding Tester}" Width="Auto" MinWidth="95"/>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="Ngày Hết Hạn" Binding="{Binding ExpirationDate}" Width="Auto" MinWidth="120"/>

                    <!-- EDIT & DELETE BUTTONS -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                            Click="BtnEdit_Click" ToolTip="Chỉnh sửa máy ảo">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0"
                                            Click="BtnDelete_Click" ToolTip="Xóa máy ảo này">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,8,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtSummary" Text="Tổng cộng: 0 máy ảo" FontWeight="SemiBold"
                           FontSize="12" Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Nháy đúp vào dòng hoặc nhấn nút Play để mở Remote Desktop"
                           HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
