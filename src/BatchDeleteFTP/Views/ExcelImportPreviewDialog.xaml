<Window x:Class="BatchDeleteFTP.Views.ExcelImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xem Trước Dữ Liệu Import Từ Excel"
        Height="600" Width="1000" MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileExcelOutline" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Xem Trước &amp; Xác Nhận Import Excel" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtFilePathSubtitle" Text="File: ..." FontSize="11" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtCountBadge" Text="0 dòng" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppHeaderForegroundBrush}"/>
            </DockPanel>
        </Border>

        <!-- OPTIONS & SHEET SELECTOR BAR -->
        <Border Grid.Row="1" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="14,10,14,6" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- Conflict Mode (Right-aligned) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Khi trùng IP/Tên máy:" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbOverwrite" Content="Ghi đè" IsChecked="True" Margin="0,0,12,0"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                    <RadioButton x:Name="RbSkip" Content="Bỏ qua" Margin="0,0,12,0"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                    <RadioButton x:Name="RbAppend" Content="Thêm tất cả"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                </StackPanel>

                <!-- Sheet Selector (Left-aligned) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="TableMultiple" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,6,0"
                                             Foreground="{DynamicResource AppPrimaryBrush}"/>
                    <TextBlock Text="Chọn Sheet:" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboSheets" Width="300" Height="32" VerticalAlignment="Center"
                              DisplayMemberPath="DisplayText" SelectionChanged="CboSheets_SelectionChanged"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- PREVIEW DATAGRID -->
        <materialDesign:Card Grid.Row="2" Margin="14,4,14,10" Padding="8">
            <DataGrid x:Name="GridPreview" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      Background="{DynamicResource AppCardBackgroundBrush}"
                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding No}" Width="50"/>
                    <DataGridTextColumn Header="Địa Chỉ IP" Binding="{Binding Ip}" Width="130" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Tên Máy" Binding="{Binding MachineName}" Width="140"/>
                    <DataGridTextColumn Header="Domain/Workgroup" Binding="{Binding DomainOrWorkgroup}" Width="130"/>
                    <DataGridTextColumn Header="Hệ Điều Hành (OS)" Binding="{Binding Os}" Width="180"/>
                    <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="110"/>
                    <DataGridTextColumn Header="Password" Binding="{Binding Password}" Width="100"/>
                    <DataGridTextColumn Header="TNS" Binding="{Binding Tns}" Width="110"/>
                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="120"/>
                    <DataGridTextColumn Header="Oracle Ver" Binding="{Binding OracleVersion}" Width="100"/>
                    <DataGridTextColumn Header="Người KT" Binding="{Binding Tester}" Width="90"/>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="180"/>
                    <DataGridTextColumn Header="Ngày Hết Hạn" Binding="{Binding ExpirationDate}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- FOOTER -->
        <Border Grid.Row="3" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Kiểm tra thông tin trước khi nhấn Import." VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="34" Width="90" Margin="0,0,8,0" Click="BtnCancel_Click" Content="Hủy"/>
                    <Button x:Name="BtnConfirm" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="34" Padding="16,0" Click="BtnConfirm_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Xác Nhận Import Vào Hệ Thống" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
