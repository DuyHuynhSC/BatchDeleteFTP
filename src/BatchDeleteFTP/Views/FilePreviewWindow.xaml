<Window x:Class="BatchDeleteFTP.Views.FilePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xem File - BatchDeleteFTP" Height="650" Width="850"
        MinHeight="450" MinWidth="600"
        Icon="pack://application:,,,/BatchDeleteFTP;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#283593" Padding="16,10"
                TextElement.Foreground="White"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <materialDesign:PackIcon x:Name="IconFile" Kind="FileDocumentOutline" Width="28" Height="28"
                                         VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFileName" Text="filename.txt" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="TxtRemotePath" Text="/path/to/filename.txt" FontSize="12" Opacity="0.85"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Meta Bar -->
        <Border Grid.Row="1" Background="#0A000000" Padding="14,6" BorderThickness="0,0,0,1" BorderBrush="#22888888">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Kích thước: " FontWeight="SemiBold" FontSize="12" Opacity="0.75"/>
                    <TextBlock x:Name="TxtFileSize" Text="0 B" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>

                    <TextBlock Text="Cập nhật: " FontWeight="SemiBold" FontSize="12" Opacity="0.75"/>
                    <TextBlock x:Name="TxtFileModified" Text="-" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>

                    <TextBlock Text="Định dạng: " FontWeight="SemiBold" FontSize="12" Opacity="0.75"/>
                    <TextBlock x:Name="TxtFileType" Text="Text File" FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkWarpText" Content="Tự động xuống dòng" FontSize="12"
                              IsChecked="True" Checked="ChkWarpText_Changed" Unchecked="ChkWarpText_Changed"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="12,8">
            <!-- Text Preview -->
            <Border x:Name="TextContainer" Background="#1E1E1E" CornerRadius="6" Padding="8" Visibility="Visible">
                <TextBox x:Name="TxtContent" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13"
                         Background="Transparent" Foreground="#D4D4D4"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </Border>

            <!-- Image Preview -->
            <ScrollViewer x:Name="ImageContainer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <Border Background="#12000000" CornerRadius="6" Padding="10">
                    <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ScrollViewer>

            <!-- Binary / Unsupported Fallback -->
            <StackPanel x:Name="BinaryContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <materialDesign:PackIcon Kind="FileQuestionOutline" Width="64" Height="64" HorizontalAlignment="Center" Opacity="0.4" Margin="0,0,0,12"/>
                <TextBlock Text="Tập tin này không hỗ trợ xem trực tiếp dạng văn bản."
                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Bạn có thể mở bằng ứng dụng mặc định trên Windows hoặc tải về máy."
                           FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1976D2" BorderBrush="#1976D2" Foreground="White"
                        HorizontalAlignment="Center" Padding="16,0" Height="36"
                        Click="BtnOpenDefault_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="OpenInApp" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mở Bằng Ứng Dụng Mặc Định" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="#22888888" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#1976D2" BorderBrush="#1976D2" Foreground="White"
                            Height="34" Padding="14,0" Margin="0,0,8,0" Click="BtnOpenDefault_Click"
                            ToolTip="Mở tập tin bằng ứng dụng mặc định của hệ thống Windows">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="OpenInApp" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Mở Với Ứng Dụng Mặc Định" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="34" Padding="14,0" Click="BtnSaveAs_Click"
                            ToolTip="Lưu tập tin này vào một vị trí trên máy tính">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Lưu Thành File..." VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Height="34" Padding="16,0" Click="BtnClose_Click">
                        <TextBlock Text="Đóng" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>