<Window x:Class="BatchDeleteFTP.Views.RemoteFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn Thư Mục Trên FTP Server" Height="520" Width="600"
        MinHeight="400" MinWidth="480"
        Icon="pack://application:,,,/BatchDeleteFTP;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:ColorZone Mode="PrimaryMid" Grid.Row="0" Padding="16,12" materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Chọn Thư Mục Trên FTP Server" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Mở rộng (▶) để tải thư mục con và tích chọn [x] một hoặc nhiều thư mục cần quét xóa"
                               FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- TreeView Card -->
        <materialDesign:Card Grid.Row="1" Margin="14,12,14,8" Padding="8" UniformCornerRadius="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <TreeView x:Name="FolderTreeView" BorderThickness="0"
                      TreeViewItem.Expanded="FolderTreeViewItem_Expanded">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="4,3"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <materialDesign:PackIcon Kind="Folder" Width="18" Height="18"
                                                     Foreground="#FFA000" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FullPath, StringFormat=' ({0})'}" Opacity="0.6" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </materialDesign:Card>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="14,4,14,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.75" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="34" Padding="16,0" Margin="0,0,10,0" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Hủy" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="34" Padding="16,0" Click="BtnConfirm_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xác nhận chọn" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
