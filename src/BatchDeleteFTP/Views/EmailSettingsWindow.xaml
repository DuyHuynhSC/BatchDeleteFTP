<Window x:Class="BatchDeleteFTP.Views.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cấu hình Gửi Email Báo Cáo Xem Trước" Height="570" Width="670"
        MinHeight="520" MinWidth="580"
        Icon="pack://application:,,,/BatchDeleteFTP;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#283593" Padding="16,12"
                TextElement.Foreground="White"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="EmailFastOutline" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cấu hình Gửi Email Kết Quả Xem Trước" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Thiết lập Outgoing Server (SMTP - Port 25/587) và danh sách email thành viên nhận báo cáo"
                               FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,4">
            <StackPanel>
                <!-- Card 1: SMTP Server -->
                <materialDesign:Card Padding="16,12" Margin="0,0,0,12" UniformCornerRadius="8"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="ServerSecurity" Width="19" Height="19"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="1. Máy chủ Gửi Mail - Outgoing Server (SMTP)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtSmtpHost" Grid.Column="0" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="SMTP Host (VD: mail.fujinet.net)"/>

                            <TextBox x:Name="TxtSmtpPort" Grid.Column="1" Margin="0,0,16,0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="SMTP Port (25 / 587)"
                                     ToolTip="Cổng gửi mail SMTP thường là 25 (không SSL) hoặc 587 (TLS). Lưu ý: 143 là cổng nhận IMAP."/>

                            <CheckBox x:Name="ChkSmtpSsl" Grid.Column="2" Content="Bật SSL / TLS"
                                      VerticalAlignment="Center" FontWeight="SemiBold"
                                      ToolTip="Bỏ tích nếu trong Thunderbird chọn Connection security: None (Port 25)"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtSmtpUser" Grid.Column="0" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Tài khoản (User Name, VD: duy-hd)"/>

                            <PasswordBox x:Name="TxtSmtpPassword" Grid.Column="1"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="Mật khẩu Email"/>
                        </Grid>

                        <TextBox x:Name="TxtSenderEmail"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Địa chỉ Email người gửi (VD: duy-hd@fujinet.net - để trống sẽ tự ghép theo Host)"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card 2: Recipient Emails -->
                <materialDesign:Card Padding="16,12" UniformCornerRadius="8"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountMultipleCheckOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="2. Danh sách Email Thành viên Nhận Báo Cáo" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtRecipientCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppSectionIconBrush}"
                                       Text="0 email hợp lệ"/>
                        </DockPanel>

                        <TextBox x:Name="TxtRecipientEmails"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="95" Padding="10,10"
                                 materialDesign:HintAssist.Hint="Nhập nhiều email cách nhau bởi dấu ; , hoặc Enter (VD: a@fujinet.net; b@fujinet.net)"
                                 TextChanged="TxtRecipientEmails_TextChanged"/>

                        <CheckBox x:Name="ChkAutoSendOnPreview" Margin="0,10,0,0"
                                  Content="Tự động gửi Email cho các thành viên mỗi khi nhấn 'Xem Trước (Preview)' hoặc chạy '--preview'"
                                  FontWeight="SemiBold"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="14,8,14,14">
            <Button x:Name="BtnTestEmail" DockPanel.Dock="Left"
                    Style="{StaticResource AppOutlinedButtonStyle}"
                    Height="34" Padding="14,0" Click="BtnTestEmail_Click"
                    ToolTip="Gửi một email kiểm tra cấu hình SMTP tới danh sách thành viên">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="EmailCheckOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtTestEmailLabel" Text="Gửi Email Thử (Test)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppOutlinedButtonStyle}"
                        Height="34" Padding="16,0" Margin="0,0,10,0" IsCancel="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Hủy" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSaveEmailSettings" Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1976D2" BorderBrush="#1976D2" Foreground="White"
                        Height="34" Padding="16,0" Click="BtnSaveEmailSettings_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Lưu Cấu Hình Email" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
