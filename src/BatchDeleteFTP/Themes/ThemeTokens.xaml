<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- SHARED DYNAMIC STYLES ACROSS ALL 5 THEMES -->

    <!-- 1. Window Surface Style -->
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        <Setter Property="TextElement.FontWeight" Value="Regular" />
        <Setter Property="TextElement.FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{materialDesign:MaterialDesignFont}" />
    </Style>

    <!-- 2. Header Banner Style (Supports Glossy Top Highlight & Bevel Bottom Border) -->
    <Style x:Key="AppHeaderBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppHeaderBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppHeaderBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource AppHeaderBorderThickness}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AppHeaderForegroundBrush}" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
    </Style>

    <!-- 3. Custom Themed Card Style (Supports Skeuomorphic Bevel, Neumorphic Extrusion, Frutiger Glass) -->
    <Style x:Key="AppCardStyle" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}" />
        <Setter Property="UniformCornerRadius" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="materialDesign:Card">
                    <Grid Margin="{TemplateBinding Margin}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppCardBorderBrush}"
                                BorderThickness="{DynamicResource AppCardBorderThickness}"
                                CornerRadius="{DynamicResource AppCardCornerRadius}"
                                Effect="{DynamicResource AppCardShadowEffect}" />
                        <Border CornerRadius="{DynamicResource AppCardCornerRadius}"
                                BorderThickness="{DynamicResource AppCardBorderThickness}"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="{TemplateBinding ClipContent}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply AppCardStyle implicitly to all materialDesign:Card instances -->
    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource AppCardStyle}" />

    <!-- 4. Subtle Toolbar / Status Bar Container Style -->
    <Style x:Key="AppSubtleToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSubtlePanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSubtlePanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 5. Terminal / Log Box Container Style -->
    <Style x:Key="AppTerminalBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppTerminalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppTerminalBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 6. Dialog Footer Border Style -->
    <Style x:Key="AppDialogFooterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppDialogFooterBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSubtlePanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- 7. Outlined / Secondary Tactile Button Style -->
    <Style x:Key="AppOutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppOutlinedButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppOutlinedButtonBorder}" />
        <Setter Property="Background" Value="{DynamicResource AppOutlinedButtonBackground}" />
        <Setter Property="BorderThickness" Value="1.3" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <!-- 8. Flat Button Style -->
    <Style x:Key="AppFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppOutlinedButtonForeground}" />
    </Style>

    <!-- 9. Action Buttons (Primary, Teal, Success, Danger) -->
    <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryButtonForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AppTealButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource AppTealButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppTealButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTealButtonForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AppSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource AppSuccessButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource AppSuccessButtonForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AppDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource AppDangerButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDangerButtonForeground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

</ResourceDictionary>
