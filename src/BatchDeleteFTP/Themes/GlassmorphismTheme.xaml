<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 7. GLASSMORPHISM THEME PALETTE & EFFECTS (Frosted Translucent Glass, Ultra-Blur Ambient Glow, Crystalline Borders) -->

    <!-- Deep Ambient Aurora Space Window Background -->
    <LinearGradientBrush x:Key="AppWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18132B" Offset="0.0" />
        <GradientStop Color="#0F1F38" Offset="0.55" />
        <GradientStop Color="#0B2B38" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Translucent Frosted Glass Card Surface -->
    <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0.0" />
        <GradientStop Color="#16FFFFFF" Offset="0.5" />
        <GradientStop Color="#1CFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Crisp Luminous Refractive Glass Border -->
    <LinearGradientBrush x:Key="AppCardBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70FFFFFF" Offset="0.0" />
        <GradientStop Color="#25FFFFFF" Offset="0.5" />
        <GradientStop Color="#45FFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <Thickness x:Key="AppCardBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">14</CornerRadius>

    <!-- Diffuse Ambient Atmospheric Glass Glow -->
    <DropShadowEffect x:Key="AppCardShadowEffect"
                      BlurRadius="28" ShadowDepth="4" Direction="270"
                      Color="#000000" Opacity="0.58" />

    <!-- Header Banner: Glassmorphic Floating Top Bar -->
    <LinearGradientBrush x:Key="AppHeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#40463378" Offset="0.0" />
        <GradientStop Color="#351B4268" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBorderBrush" Color="#55FFFFFF" />
    <Thickness x:Key="AppHeaderBorderThickness">0,0,0,1.5</Thickness>
    <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBackgroundBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBorderBrush" Color="#50FFFFFF" />

    <!-- Typography & Icon Accents -->
    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#F0F4FC" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#A5B9DE" />
    <SolidColorBrush x:Key="AppSectionIconBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AppAccentHighlightBrush" Color="#38BDF8" />

    <!-- Subtle Containers (Crystal Ice Shelf) -->
    <LinearGradientBrush x:Key="AppSubtlePanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1EFFFFFF" Offset="0.0" />
        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppSubtlePanelBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AppDialogFooterBackgroundBrush" Color="#18223B" />

    <!-- Terminal / Activity Log Box: Deep Smoked Glass Obsidian -->
    <SolidColorBrush x:Key="AppTerminalBackgroundBrush" Color="#0B111E" />
    <SolidColorBrush x:Key="AppTerminalForegroundBrush" Color="#5EEAD4" />
    <SolidColorBrush x:Key="AppTerminalBorderBrush" Color="#33507A" />

    <!-- Outlined & Glass Sheer Buttons -->
    <SolidColorBrush x:Key="AppOutlinedButtonForeground" Color="#E0ECFF" />
    <SolidColorBrush x:Key="AppOutlinedButtonBorder" Color="#50FFFFFF" />
    <LinearGradientBrush x:Key="AppOutlinedButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#25FFFFFF" Offset="0.0" />
        <GradientStop Color="#10FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Action Button Brushes (Luminous Translucent Glass Gems) -->
    <LinearGradientBrush x:Key="AppPrimaryButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0284C7" Offset="0.0" />
        <GradientStop Color="#0369A1" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppPrimaryButtonBorder" Color="#38BDF8" />
    <SolidColorBrush x:Key="AppPrimaryButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppTealButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D9488" Offset="0.0" />
        <GradientStop Color="#0F766E" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppTealButtonBorder" Color="#2DD4BF" />
    <SolidColorBrush x:Key="AppTealButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppSuccessButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16A34A" Offset="0.0" />
        <GradientStop Color="#15803D" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppSuccessButtonBorder" Color="#4ADE80" />
    <SolidColorBrush x:Key="AppSuccessButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppDangerButtonBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0.0" />
        <GradientStop Color="#B91C1C" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppDangerButtonBorder" Color="#F87171" />
    <SolidColorBrush x:Key="AppDangerButtonForeground" Color="#FFFFFF" />

    <!-- Glass Refractive Sheen -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AppGlossyOverlayOpacity">0.25</sys:Double>

</ResourceDictionary>
