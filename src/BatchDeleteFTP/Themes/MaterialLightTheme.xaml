<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 1. MATERIAL LIGHT THEME PALETTE & EFFECTS -->

    <!-- Window & Surface Brushes -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#18000000" />
    <Thickness x:Key="AppCardBorderThickness">1</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>

    <DropShadowEffect x:Key="AppCardShadowEffect"
                      BlurRadius="10" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.10" />

    <!-- Header Banner -->
    <LinearGradientBrush x:Key="AppHeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#283593" Offset="0.0" />
        <GradientStop Color="#1E88E5" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBorderBrush" Color="#1A237E" />
    <Thickness x:Key="AppHeaderBorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBackgroundBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBorderBrush" Color="#48FFFFFF" />

    <!-- Typography & Icon Accents -->
    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="AppSectionIconBrush" Color="#3949AB" />
    <SolidColorBrush x:Key="AppAccentHighlightBrush" Color="#1976D2" />

    <!-- Subtle Containers (Toolbar, Footer, Meta Bar) -->
    <SolidColorBrush x:Key="AppSubtlePanelBackgroundBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="AppSubtlePanelBorderBrush" Color="#22888888" />
    <SolidColorBrush x:Key="AppDialogFooterBackgroundBrush" Color="#F8FAFC" />

    <!-- Terminal / Activity Log Box -->
    <SolidColorBrush x:Key="AppTerminalBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AppTerminalForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="AppTerminalBorderBrush" Color="#333333" />

    <!-- Outlined & Flat Buttons -->
    <SolidColorBrush x:Key="AppOutlinedButtonForeground" Color="#1A237E" />
    <SolidColorBrush x:Key="AppOutlinedButtonBorder" Color="#3949AB" />
    <SolidColorBrush x:Key="AppOutlinedButtonBackground" Color="#123949AB" />

    <!-- Action Button Brushes (Primary, Teal, Success, Danger) -->
    <SolidColorBrush x:Key="AppPrimaryButtonBackground" Color="#1976D2" />
    <SolidColorBrush x:Key="AppPrimaryButtonBorder" Color="#1565C0" />
    <SolidColorBrush x:Key="AppPrimaryButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppTealButtonBackground" Color="#00897B" />
    <SolidColorBrush x:Key="AppTealButtonBorder" Color="#00695C" />
    <SolidColorBrush x:Key="AppTealButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppSuccessButtonBackground" Color="#2E7D32" />
    <SolidColorBrush x:Key="AppSuccessButtonBorder" Color="#1B5E20" />
    <SolidColorBrush x:Key="AppSuccessButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppDangerButtonBackground" Color="#D32F2F" />
    <SolidColorBrush x:Key="AppDangerButtonBorder" Color="#B71C1C" />
    <SolidColorBrush x:Key="AppDangerButtonForeground" Color="#FFFFFF" />

    <!-- Glossy Overlay Opacity (0 for flat Material) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AppGlossyOverlayOpacity">0.0</sys:Double>

</ResourceDictionary>
