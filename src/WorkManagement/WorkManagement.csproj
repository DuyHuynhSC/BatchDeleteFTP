<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>WorkManagement</AssemblyName>
    <RootNamespace>WorkManagement</RootNamespace>
    <AssemblyTitle>WorkManagement</AssemblyTitle>
    <Product>WorkManagement</Product>
    <Description>WorkManagement - DevOps Workspace &amp; FTP Automation Hub</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="51.1.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
  </ItemGroup>

</Project>
