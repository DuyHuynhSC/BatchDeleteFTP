<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 2. MATERIAL DARK THEME PALETTE & EFFECTS -->

    <!-- Window & Surface Brushes -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#334155" />
    <Thickness x:Key="AppCardBorderThickness">1</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>

    <DropShadowEffect x:Key="AppCardShadowEffect"
                      BlurRadius="14" ShadowDepth="3" Direction="270"
                      Color="#000000" Opacity="0.45" />

    <!-- Header Banner -->
    <LinearGradientBrush x:Key="AppHeaderBackgroundBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E293B" Offset="0.0" />
        <GradientStop Color="#0F172A" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBorderBrush" Color="#334155" />
    <Thickness x:Key="AppHeaderBorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppHeaderPillBackgroundBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBorderBrush" Color="#40FFFFFF" />

    <!-- Typography & Icon Accents -->
    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppSectionIconBrush" Color="#64B5F6" />
    <SolidColorBrush x:Key="AppAccentHighlightBrush" Color="#60A5FA" />

    <!-- Subtle Containers (Toolbar, Footer, Meta Bar) -->
    <SolidColorBrush x:Key="AppSubtlePanelBackgroundBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="AppSubtlePanelBorderBrush" Color="#3394A3B8" />
    <SolidColorBrush x:Key="AppDialogFooterBackgroundBrush" Color="#1E293B" />

    <!-- Terminal / Activity Log Box -->
    <SolidColorBrush x:Key="AppTerminalBackgroundBrush" Color="#090D16" />
    <SolidColorBrush x:Key="AppTerminalForegroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="AppTerminalBorderBrush" Color="#334155" />

    <!-- Outlined & Flat Buttons -->
    <SolidColorBrush x:Key="AppOutlinedButtonForeground" Color="#E3F2FD" />
    <SolidColorBrush x:Key="AppOutlinedButtonBorder" Color="#64B5F6" />
    <SolidColorBrush x:Key="AppOutlinedButtonBackground" Color="#2442A5F5" />

    <!-- Action Button Brushes -->
    <SolidColorBrush x:Key="AppPrimaryButtonBackground" Color="#0288D1" />
    <SolidColorBrush x:Key="AppPrimaryButtonBorder" Color="#29B6F6" />
    <SolidColorBrush x:Key="AppPrimaryButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppTealButtonBackground" Color="#00897B" />
    <SolidColorBrush x:Key="AppTealButtonBorder" Color="#26A69A" />
    <SolidColorBrush x:Key="AppTealButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppSuccessButtonBackground" Color="#2E7D32" />
    <SolidColorBrush x:Key="AppSuccessButtonBorder" Color="#66BB6A" />
    <SolidColorBrush x:Key="AppSuccessButtonForeground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="AppDangerButtonBackground" Color="#C62828" />
    <SolidColorBrush x:Key="AppDangerButtonBorder" Color="#EF5350" />
    <SolidColorBrush x:Key="AppDangerButtonForeground" Color="#FFFFFF" />

    <!-- Glossy Overlay Opacity -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AppGlossyOverlayOpacity">0.0</sys:Double>

</ResourceDictionary>
