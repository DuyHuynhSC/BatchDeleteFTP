<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- 5. FRUTIGER AERO THEME PALETTE & EFFECTS (Windows Vista/7 Aero Glass, Aqua Sky & Fresh Emerald, Glossy Gel Reflection) -->

    <!-- Sky-to-Mint Refreshing Horizon Background -->
    <LinearGradientBrush x:Key="AppWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D4F1FF" Offset="0.0" />
        <GradientStop Color="#E8F9FF" Offset="0.50" />
        <GradientStop Color="#D8F8EA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Translucent Frosted Aero Glass Card -->
    <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4FFFFFF" Offset="0.0" />
        <GradientStop Color="#DDF2FAFF" Offset="0.48" />
        <GradientStop Color="#EBF7FCFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Luminous White-Cyan Glass Rim -->
    <LinearGradientBrush x:Key="AppCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
        <GradientStop Color="#9970C8F0" Offset="1.0" />
    </LinearGradientBrush>
    <Thickness x:Key="AppCardBorderThickness">1.5</Thickness>
    <CornerRadius x:Key="AppCardCornerRadius">10</CornerRadius>

    <DropShadowEffect x:Key="AppCardShadowEffect"
                      BlurRadius="14" ShadowDepth="3" Direction="270"
                      Color="#0277BD" Opacity="0.18" />

    <!-- Header Banner: Deep Ocean Glass with Glossy Top Sheen -->
    <LinearGradientBrush x:Key="AppHeaderBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2FA8EC" Offset="0.0" />
        <GradientStop Color="#0D7CC6" Offset="0.49" />
        <GradientStop Color="#035A9E" Offset="0.50" />
        <GradientStop Color="#00899B" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppHeaderBorderBrush" Color="#80FFFFFF" />
    <Thickness x:Key="AppHeaderBorderThickness">0,0,0,1.5</Thickness>
    <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBackgroundBrush" Color="#35FFFFFF" />
    <SolidColorBrush x:Key="AppHeaderPillBorderBrush" Color="#88FFFFFF" />

    <!-- Typography & Icon Accents -->
    <SolidColorBrush x:Key="AppPrimaryTextBrush" Color="#052C47" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#346888" />
    <SolidColorBrush x:Key="AppSectionIconBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AppAccentHighlightBrush" Color="#0088CC" />

    <!-- Subtle Containers (Crystal Aqua Bar) -->
    <LinearGradientBrush x:Key="AppSubtlePanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0.0" />
        <GradientStop Color="#66D0F0FF" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppSubtlePanelBorderBrush" Color="#8878C5E8" />
    <LinearGradientBrush x:Key="AppDialogFooterBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEFAFEFF" Offset="0.0" />
        <GradientStop Color="#DDE1F5FE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Terminal / Activity Log Box: Deep Midnight Ocean Glass -->
    <LinearGradientBrush x:Key="AppTerminalBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#061D30" Offset="0.0" />
        <GradientStop Color="#0B2E47" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppTerminalForegroundBrush" Color="#80F0FF" />
    <SolidColorBrush x:Key="AppTerminalBorderBrush" Color="#3898D0" />

    <!-- Outlined & Crystal Aero Buttons -->
    <SolidColorBrush x:Key="AppOutlinedButtonForeground" Color="#034873" />
    <SolidColorBrush x:Key="AppOutlinedButtonBorder" Color="#35A4E0" />
    <LinearGradientBrush x:Key="AppOutlinedButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0.0" />
        <GradientStop Color="#D9E8F8FF" Offset="0.50" />
        <GradientStop Color="#C4D4F1FF" Offset="0.51" />
        <GradientStop Color="#E0F7FF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Action Button Brushes (2-Tone Glossy Gel Gradients) -->
    <LinearGradientBrush x:Key="AppPrimaryButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4CC3FF" Offset="0.0" />
        <GradientStop Color="#128EE0" Offset="0.49" />
        <GradientStop Color="#006EC4" Offset="0.50" />
        <GradientStop Color="#0095EB" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppPrimaryButtonBorder" Color="#005299" />
    <SolidColorBrush x:Key="AppPrimaryButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppTealButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3CE8D1" Offset="0.0" />
        <GradientStop Color="#00B09B" Offset="0.49" />
        <GradientStop Color="#008E7B" Offset="0.50" />
        <GradientStop Color="#00BFA5" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppTealButtonBorder" Color="#00695C" />
    <SolidColorBrush x:Key="AppTealButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppSuccessButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6AE876" Offset="0.0" />
        <GradientStop Color="#28B53B" Offset="0.49" />
        <GradientStop Color="#169428" Offset="0.50" />
        <GradientStop Color="#2ECA44" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppSuccessButtonBorder" Color="#11701E" />
    <SolidColorBrush x:Key="AppSuccessButtonForeground" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="AppDangerButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7A7A" Offset="0.0" />
        <GradientStop Color="#E53935" Offset="0.49" />
        <GradientStop Color="#C62828" Offset="0.50" />
        <GradientStop Color="#EF5350" Offset="1.0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppDangerButtonBorder" Color="#8E1616" />
    <SolidColorBrush x:Key="AppDangerButtonForeground" Color="#FFFFFF" />

    <!-- High Glossy Top Reflection Overlay for Frutiger Aero -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="AppGlossyOverlayOpacity">0.42</sys:Double>

</ResourceDictionary>
