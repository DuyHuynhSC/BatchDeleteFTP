<UserControl x:Class="WorkManagement.Views.EmailSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <!-- Body -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Stretch">
            <!-- Card 1: SMTP Server -->
            <materialDesign:Card Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ServerSecurity" Width="20" Height="20"
                                                 Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="1. Máy chủ Gửi Mail - Outgoing Server (SMTP)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSmtpHost" Grid.Column="0" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="SMTP Host (VD: mail.fujinet.net)"/>

                        <TextBox x:Name="TxtSmtpPort" Grid.Column="1" Margin="0,0,16,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="SMTP Port (25 / 587)"
                                 ToolTip="Cổng gửi mail SMTP thường là 25 (không SSL) hoặc 587 (TLS). Lưu ý: 143 là cổng nhận IMAP."/>

                        <CheckBox x:Name="ChkSmtpSsl" Grid.Column="2" Content="Bật SSL / TLS"
                                  VerticalAlignment="Center" FontWeight="SemiBold"
                                  ToolTip="Bỏ tích nếu trong Thunderbird chọn Connection security: None (Port 25)"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtSmtpUser" Grid.Column="0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Tài khoản (User Name, VD: user-dev)"/>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtSmtpPassword" Grid.Column="0"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="Mật khẩu Email"/>
                            <TextBox x:Name="TxtSmtpPasswordRevealed" Grid.Column="0" Visibility="Collapsed"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Mật khẩu Email"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="28" Height="28" Padding="0" Margin="4,0,0,2" VerticalAlignment="Bottom"
                                    Click="BtnToggleSmtpPassword_Click" ToolTip="Ẩn / Hiện Mật khẩu Email">
                                <materialDesign:PackIcon x:Name="IconSmtpPassEye" Kind="EyeOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <TextBox x:Name="TxtSenderEmail" Margin="0,0,0,4"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Địa chỉ Email người gửi (VD: user-dev@fujinet.net - để trống sẽ tự ghép theo Host)"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Card 2: Recipient Emails -->
            <materialDesign:Card Padding="16,14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountMultipleCheckOutline" Width="20" Height="20"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="2. Danh sách Email Thành viên Nhận Báo Cáo" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtRecipientCount" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppSectionIconBrush}"
                                   Text="0 email hợp lệ"/>
                    </DockPanel>

                    <TextBox x:Name="TxtRecipientEmails"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="105" Padding="10,10"
                             materialDesign:HintAssist.Hint="Nhập nhiều email cách nhau bởi dấu ; , hoặc Enter (VD: a@fujinet.net; b@fujinet.net)"
                             TextChanged="TxtRecipientEmails_TextChanged"/>

                    <CheckBox x:Name="ChkAutoSendOnPreview" Margin="0,12,0,0"
                              Content="Tự động gửi Email cho các thành viên mỗi khi nhấn 'Xem Trước (Preview)' hoặc chạy '--preview'"
                              FontWeight="SemiBold"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- ACTION BUTTONS: NẰM SÁT NGAY DƯỚI FORM NHẬP THÔNG TIN -->
            <Border Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnTestEmail" DockPanel.Dock="Left"
                            Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="36" Padding="14,0" Click="BtnTestEmail_Click"
                            ToolTip="Gửi một email kiểm tra cấu hình SMTP tới danh sách thành viên">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EmailCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTestEmailLabel" Text="Gửi Email Thử (Test)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnSaveEmailSettings" Style="{StaticResource AppPrimaryButtonStyle}"
                                Height="36" Padding="20,0" Click="BtnSaveEmailSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu Cấu Hình Email" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
