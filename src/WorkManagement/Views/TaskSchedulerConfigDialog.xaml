<Window x:Class="WorkManagement.Views.TaskSchedulerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cấu Hình Windows Task Scheduler"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cấu Hình Lịch Chạy Windows Task Scheduler" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Tự động quét, backup và dọn dẹp file FTP định kỳ ở chế độ Console ngầm" FontSize="11" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="16,12">
            <StackPanel>
                <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="THIẾT LẬP THỜI GIAN &amp; CHẾ ĐỘ CHẠY" FontWeight="Bold" FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,12"/>

                        <!-- TRIGGER SELECTION -->
                        <TextBlock Text="Thời điểm kích hoạt Task:" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton x:Name="RbTriggerLogon" IsChecked="True" Margin="0,0,0,6"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Checked="TriggerType_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LoginVariant" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{DynamicResource AppPrimaryBrush}"/>
                                    <TextBlock Text="Khi khởi động / đăng nhập Windows (Tự động delay 1 phút chờ mạng/VPN sẵn sàng)"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RbTriggerDaily" Margin="0,0,0,2"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Checked="TriggerType_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chạy định kỳ vào giờ cố định hàng ngày (HH:mm)"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBox x:Name="TxtTaskName" Margin="0,0,0,10"
                                 materialDesign:HintAssist.Hint="Tên Task trong Windows Task Scheduler"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"
                                 Text="WorkManagement_MorningPreview"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 TextChanged="TxtTaskName_TextChanged"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtRunTime" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Thời gian chạy hàng ngày (HH:mm, vd: 23:00)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Text="23:00" IsEnabled="False"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     TextChanged="TxtRunTime_TextChanged"/>

                            <ComboBox x:Name="CboExecutionMode" Grid.Column="2"
                                      materialDesign:HintAssist.Hint="Chế độ thực thi"
                                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      SelectionChanged="CboExecutionMode_SelectionChanged">
                                <ComboBoxItem Content="Chỉ Preview &amp; Gửi Mail Báo Cáo (--preview)" IsSelected="True"/>
                                <ComboBoxItem Content="Tự động Backup &amp; Xóa (--auto)"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkAllProfiles" Content="Áp dụng cho tất cả Profiles FTP (--all)"
                                  IsChecked="True" Margin="0,0,0,6"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Checked="UpdateCommandPreview" Unchecked="UpdateCommandPreview"/>

                        <CheckBox x:Name="ChkSendEmail" Content="Gửi email thông báo kết quả (--send-email)"
                                  IsChecked="True" Margin="0,0,0,10"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Checked="UpdateCommandPreview" Unchecked="UpdateCommandPreview"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="LỆNH ĐĂNG KÝ HỆ THỐNG (COMMAND PREVIEW)" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource AppFlatButtonStyle}" Height="26" Padding="6,0"
                                    HorizontalAlignment="Right" Click="BtnCopyCmd_Click" ToolTip="Sao chép lệnh vào Clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Copy Lệnh" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <TextBox x:Name="TxtCmdPreview" TextWrapping="Wrap" IsReadOnly="True"
                                 Background="{DynamicResource AppTerminalBackgroundBrush}"
                                 Foreground="{DynamicResource AppTerminalForegroundBrush}"
                                 BorderBrush="{DynamicResource AppTerminalBorderBrush}"
                                 BorderThickness="1" FontFamily="Consolas, Courier New" FontSize="11"
                                 Padding="8" Height="68" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12">
            <DockPanel>
                <Button x:Name="BtnDeleteTask" Style="{StaticResource AppDangerButtonStyle}"
                        DockPanel.Dock="Left" Height="34" Padding="12,0" Click="BtnDeleteTask_Click"
                        ToolTip="Xóa Task này khỏi Windows Task Scheduler">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa Task" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnClose" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="34" Width="90" Margin="0,0,8,0" Click="BtnClose_Click" Content="Đóng"/>
                    <Button x:Name="BtnRegisterTask" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="34" Padding="14,0" Click="BtnRegisterTask_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarPlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Tạo Task Vào Windows" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
