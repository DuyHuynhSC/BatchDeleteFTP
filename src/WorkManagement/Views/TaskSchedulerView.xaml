<UserControl x:Class="WorkManagement.Views.TaskSchedulerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <materialDesign:Card Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="THIẾT LẬP THỜI GIAN &amp; CHẾ ĐỘ CHẠY" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- TRIGGER SELECTION -->
                        <TextBlock Text="Thời điểm kích hoạt Task:" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,12">
                            <RadioButton x:Name="RbTriggerLogon" IsChecked="True" Margin="0,0,0,8"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Checked="TriggerType_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LoginVariant" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Foreground="{DynamicResource AppPrimaryBrush}"/>
                                    <TextBlock Text="Khi khởi động / đăng nhập Windows (Tự động delay 1 phút chờ mạng/VPN sẵn sàng)"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RbTriggerDaily" Margin="0,0,0,4"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Checked="TriggerType_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Chạy định kỳ vào giờ cố định hàng ngày (HH:mm)"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBox x:Name="TxtTaskName" Margin="0,0,0,14"
                                 materialDesign:HintAssist.Hint="Tên Task trong Windows Task Scheduler"
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"
                                 Text="WorkManagement_MorningPreview"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 TextChanged="TxtTaskName_TextChanged"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtRunTime" Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Thời gian chạy hàng ngày (HH:mm, vd: 23:00)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Text="23:00" IsEnabled="False"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     TextChanged="TxtRunTime_TextChanged"/>

                            <ComboBox x:Name="CboExecutionMode" Grid.Column="2"
                                      materialDesign:HintAssist.Hint="Chế độ thực thi"
                                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      SelectionChanged="CboExecutionMode_SelectionChanged">
                                <ComboBoxItem Content="Chỉ Preview &amp; Gửi Mail Báo Cáo (--preview)" IsSelected="True"/>
                                <ComboBoxItem Content="Tự động Backup &amp; Xóa (--auto)"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkAllProfiles" Content="Áp dụng cho tất cả Profiles FTP (--all)"
                                  IsChecked="True" Margin="0,0,0,8"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Checked="UpdateCommandPreview" Unchecked="UpdateCommandPreview"/>

                        <CheckBox x:Name="ChkSendEmail" Content="Gửi email thông báo kết quả (--send-email)"
                                  IsChecked="True" Margin="0,0,0,10"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Checked="UpdateCommandPreview" Unchecked="UpdateCommandPreview"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ConsoleLine" Width="18" Height="18"
                                                         Foreground="{DynamicResource AppSectionIconBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="LỆNH ĐĂNG KÝ HỆ THỐNG (COMMAND PREVIEW)" FontWeight="Bold" FontSize="12"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource AppFlatButtonStyle}" Height="28" Padding="8,0"
                                    HorizontalAlignment="Right" Click="BtnCopyCmd_Click" ToolTip="Sao chép lệnh vào Clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Copy Lệnh" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <TextBox x:Name="TxtCmdPreview" TextWrapping="Wrap" IsReadOnly="True"
                                 Background="{DynamicResource AppTerminalBackgroundBrush}"
                                 Foreground="{DynamicResource AppTerminalForegroundBrush}"
                                 BorderBrush="{DynamicResource AppTerminalBorderBrush}"
                                 BorderThickness="1" FontFamily="Consolas, Courier New" FontSize="12"
                                 Padding="10" Height="78" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="1" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12" Margin="0,6,0,0" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnDeleteTask" Style="{StaticResource AppDangerButtonStyle}"
                        DockPanel.Dock="Left" Height="36" Padding="14,0" Click="BtnDeleteTask_Click"
                        ToolTip="Xóa Task này khỏi Windows Task Scheduler">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa Task Khỏi Hệ Thống" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRegisterTask" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="36" Padding="18,0" Click="BtnRegisterTask_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarPlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Đăng Ký Task Vào Windows" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
