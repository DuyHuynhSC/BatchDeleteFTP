<UserControl x:Class="WorkManagement.Views.ProjectManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,0,0,10" Padding="12,10">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons (Left) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnAddProject" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnAddProject_Click"
                            ToolTip="Thêm dự án mới vào danh sách">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderPlusOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm Dự Án" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnImportExcel" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnImportExcel_Click"
                            ToolTip="Nhập danh sách dự án từ file Excel (.xlsx / .xls)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import Excel" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDownloadTemplate" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnDownloadTemplate_Click"
                            ToolTip="Xuất file mẫu Excel thông tin dự án để nhập liệu">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDownloadOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="File Mẫu" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAutoFitColumns" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnAutoFitColumns_Click"
                            ToolTip="Tự động căn chỉnh độ rộng các cột vừa khít nội dung">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Auto-Fit Cột" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- NÚT XÓA DỰ ÁN (XÓA TUẦN TỰ FOLDER + DB USER + TABLESPACE) -->
                    <Button x:Name="BtnDeleteSelected" Style="{StaticResource AppDangerButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnDeleteSelected_Click"
                            ToolTip="Xóa các dự án đang chọn (xóa tuần tự Source Folder, DB User, Tablespace kèm backup)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteForeverOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa Dự Án" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteAll" Style="{StaticResource AppDangerButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnDeleteAll_Click"
                            ToolTip="Dọn sạch danh sách quản lý dự án hiện tại">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa Tất Cả" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRefresh" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnRefresh_Click"
                            ToolTip="Tải lại danh sách từ bộ nhớ">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnClearAllFilters" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnClearAllFilters_Click"
                            ToolTip="Xóa tất cả các bộ lọc cột đang áp dụng" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterOffOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                                     Foreground="{DynamicResource AppDangerButtonBackground}"/>
                            <TextBlock Text="Bỏ Lọc Cột" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppDangerButtonBackground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search Box (Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" Width="280">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Grid.Column="0"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tìm dự án, source, IP, DB user..."
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     BorderThickness="0" VerticalAlignment="Center" FontSize="12"
                                     TextChanged="TxtSearch_TextChanged"
                                     KeyDown="TxtSearch_KeyDown"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                     Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                     Visibility="Collapsed" Click="BtnClearSearch_Click">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14"
                                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN DATAGRID -->
        <materialDesign:Card Grid.Row="1" Padding="6">
            <DataGrid x:Name="GridProjects" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      Background="{DynamicResource AppCardBackgroundBrush}"
                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="GridProjects_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- CHECKBOX CHỌN DỰ ÁN ĐỂ XÓA -->
                    <DataGridTemplateColumn Width="60" MinWidth="55" MaxWidth="70" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="ChkSelectAll" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsThreeState="True" ToolTip="Chọn tất cả / Bỏ chọn tất cả"
                                      Click="ChkSelectAll_Click" Cursor="Hand">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="RowCheckBox_Click" Cursor="Hand">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NO -->
                    <DataGridTextColumn Binding="{Binding No}" Width="Auto" MinWidth="55">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_No" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="No" ToolTip="Lọc No">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="No" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- PROJECT NAME -->
                    <DataGridTextColumn Binding="{Binding ProjectName}" Width="Auto" MinWidth="130" FontWeight="Bold">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_ProjectName" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="ProjectName" ToolTip="Lọc Project">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Project" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- GIẢI THÍCH THÊM -->
                    <DataGridTextColumn Binding="{Binding Description}" Width="Auto" MinWidth="140">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Description" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Description" ToolTip="Lọc Giải thích thêm">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Giải thích thêm" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- SOURCE FOLDER (WITH OPEN & COPY BUTTON) -->
                    <DataGridTemplateColumn Width="Auto" MinWidth="180">
                        <DataGridTemplateColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_SourceFolder" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="SourceFolder" ToolTip="Lọc Source Folder">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Source Folder" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0" Margin="2,0"
                                                Click="BtnOpenFolder_Click" ToolTip="Mở thư mục trong File Explorer">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="BtnCopyFolder_Click" ToolTip="Sao chép đường dẫn">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SourceFolder}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- HOST SERVER (IP) -->
                    <DataGridTemplateColumn Width="Auto" MinWidth="150">
                        <DataGridTemplateColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_HostServer" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="HostServer" ToolTip="Lọc Host Server">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Host Server" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="22" Height="22" Padding="0" Margin="0,0,2,0"
                                                Click="BtnPlayHostRdp_Click" ToolTip="Mở Remote Desktop (RDP) dựa trên Quản lý máy ảo">
                                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14"
                                                                     Foreground="#2E7D32"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="BtnCopyHost_Click" ToolTip="Sao chép IP máy chủ">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HostServer}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- SERVICE NAME -->
                    <DataGridTextColumn Binding="{Binding ServiceName}" Width="Auto" MinWidth="105">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_ServiceName" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="ServiceName" ToolTip="Lọc Service Name">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Service Name" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- PORT -->
                    <DataGridTextColumn Binding="{Binding Port}" Width="Auto" MinWidth="75">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Port" VerticalAlignment="Center"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- TNSNAME -->
                    <DataGridTextColumn Binding="{Binding TnsName}" Width="Auto" MinWidth="110">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_TnsName" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="TnsName" ToolTip="Lọc tnsname">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="tnsname" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- DB USERS -->
                    <DataGridTemplateColumn Width="Auto" MinWidth="220">
                        <DataGridTemplateColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_DbUsers" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="DbUsers" ToolTip="Lọc DB Users">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="User (DB)" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            DockPanel.Dock="Right" Width="20" Height="20" Padding="0"
                                            Click="BtnCopyUsers_Click" ToolTip="Sao chép danh sách Users">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="12" Height="12"
                                                                 Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    </Button>
                                    <TextBlock Text="{Binding DbUsers}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TABLESPACE CẦN XÓA -->
                    <DataGridTextColumn Binding="{Binding Tablespace}" Width="Auto" MinWidth="130" FontWeight="SemiBold">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Tablespace" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Tablespace" ToolTip="Lọc Tablespace">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Tablespace Cần Xóa" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- NGƯỜI PHỤ TRÁCH -->
                    <DataGridTextColumn Binding="{Binding PersonInCharge}" Width="Auto" MinWidth="110">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_PersonInCharge" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="PersonInCharge" ToolTip="Lọc Người phụ trách">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Người phụ trách" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- GHI CHÚ -->
                    <DataGridTextColumn Binding="{Binding Notes}" Width="Auto" MinWidth="150">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Notes" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Notes" ToolTip="Lọc Ghi chú">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="11" Height="11"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Ghi chú" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- THAO TÁC (EDIT & DELETE) -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="85" MinWidth="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                            Click="BtnEdit_Click" ToolTip="Chỉnh sửa thông tin dự án">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0"
                                            Click="BtnDelete_Click" ToolTip="Xóa dự án (Folder, DB Users, Tablespace)">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,8,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtSummary" Text="Tổng cộng: 0 dự án" FontWeight="SemiBold"
                           FontSize="12" Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Tích chọn dự án và nhấn 'Xóa Dự Án' để thực thi xóa Source Folder, DB User &amp; Tablespace kèm Backup"
                           HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- EXCEL-STYLE COLUMN FILTER POPUP -->
        <Popup x:Name="FilterPopup" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="Bottom">
            <materialDesign:Card Margin="6" Padding="10" Width="270" MaxHeight="430"
                                 Background="{DynamicResource AppCardBackgroundBrush}"
                                 BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                                 BorderThickness="1"
                                 materialDesign:ElevationAssist.Elevation="Dp6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Title and Close -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Width="22" Height="22" Padding="0" Click="BtnCloseFilterPopup_Click">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Filter" Width="15" Height="15"
                                                     Foreground="{DynamicResource AppPrimaryButtonBackground}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtFilterColumnTitle" Text="Lọc Cột" FontWeight="Bold"
                                       FontSize="12" Foreground="{DynamicResource AppPrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Quick Actions: Sort & Clear Filter for this column -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSubtlePanelBackgroundBrush}"
                            CornerRadius="4" Padding="4,3" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnSortAsc" Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="5,0" Height="22" Margin="0,0,3,0" Click="BtnSortAsc_Click"
                                        ToolTip="Sắp xếp tăng dần A-Z">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SortAlphabeticalAscending" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="A-Z" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSortDesc" Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="5,0" Height="22" Click="BtnSortDesc_Click"
                                        ToolTip="Sắp xếp giảm dần Z-A">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SortAlphabeticalDescending" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Z-A" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button x:Name="BtnClearColumnFilter" Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="5,0" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Click="BtnClearColumnFilter_Click" ToolTip="Xóa lọc trên cột này">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterOffOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"
                                                             Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                    <TextBlock Text="Bỏ lọc cột" FontSize="11" Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Search Box within Popup -->
                    <Border Grid.Row="2" Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" Grid.Column="0"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtFilterSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tìm giá trị..."
                                     BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     TextChanged="TxtFilterSearch_TextChanged"/>
                            <Button x:Name="BtnClearFilterSearch" Grid.Column="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="16" Height="16" Padding="0" Visibility="Collapsed"
                                    Click="BtnClearFilterSearch_Click">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="12" Height="12"
                                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filter Items Checklist -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2" MaxHeight="190">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <CheckBox x:Name="ChkFilterSelectAll" Content="(Chọn tất cả)"
                                          Margin="6,4" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand"
                                          IsThreeState="True" Click="ChkFilterSelectAll_Click"/>
                                <Separator Margin="4,2"/>
                                <ItemsControl x:Name="ListFilterItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="6,2" FontSize="11.5" Cursor="Hand"
                                                      Click="FilterItemCheckBox_Click">
                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtFilterItemCount" Text="0 mục" FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                    Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                    Content="Hủy" Click="BtnCloseFilterPopup_Click"/>
                            <Button Style="{StaticResource AppPrimaryButtonStyle}"
                                    Height="26" Padding="12,0" FontSize="11"
                                    Content="Áp Dụng" Click="BtnApplyFilter_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </materialDesign:Card>
        </Popup>
    </Grid>
</UserControl>
