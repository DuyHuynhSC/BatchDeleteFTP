<UserControl x:Class="WorkManagement.Views.VmManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,0,0,10" Padding="12,10">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons (Left) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- NÚT PLAY CHÍNH TRÊN TOOLBAR -->
                    <Button x:Name="BtnToolbarPlay" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="32" Padding="14,0" Margin="0,0,8,0" Click="BtnToolbarPlay_Click"
                            ToolTip="Mở Remote Desktop kết nối ngay tới máy ảo đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Play (Mở RDP)" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAddVm" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnAddVm_Click"
                            ToolTip="Thêm máy ảo mới vào danh sách">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ServerPlus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm Máy Ảo" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnImportExcel" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnImportExcel_Click"
                            ToolTip="Nhập danh sách máy ảo từ file Excel (.xlsx / .xls)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import Excel" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDownloadTemplate" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnDownloadTemplate_Click"
                            ToolTip="Xuất file mẫu Excel để nhập liệu">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDownloadOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="File Mẫu" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- AUTOFIT CỘT BUTTON -->
                    <Button x:Name="BtnAutoFitColumns" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnAutoFitColumns_Click"
                            ToolTip="Tự động căn chỉnh độ rộng tất cả các cột vừa khít nội dung">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Auto-Fit Cột" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- NÚT XÓA CÁC MỤC ĐÃ CHỌN -->
                    <Button x:Name="BtnDeleteSelected" Style="{StaticResource AppDangerButtonStyle}"
                            Height="32" Padding="12,0" Margin="0,0,8,0" Click="BtnDeleteSelected_Click"
                            ToolTip="Xóa các máy ảo đang được chọn (đã tích ô chọn ở đầu dòng)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteAll" Style="{StaticResource AppDangerButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnDeleteAll_Click"
                            ToolTip="Xóa toàn bộ danh sách máy ảo hiện tại để làm mới hoặc import lại">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa Tất Cả" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRefresh" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnRefresh_Click"
                            ToolTip="Tải lại danh sách từ bộ nhớ">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Button>

                    <!-- NÚT BỎ TOÀN BỘ BỘ LỌC CỘT (EXCEL FILTER RESET) -->
                    <Button x:Name="BtnClearAllFilters" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="32" Padding="10,0" Margin="0,0,8,0" Click="BtnClearAllFilters_Click"
                            ToolTip="Xóa tất cả các bộ lọc cột đang áp dụng" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterOffOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                                     Foreground="{DynamicResource AppDangerButtonBackground}"/>
                            <TextBlock Text="Bỏ Lọc Cột" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppDangerButtonBackground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search Box (Right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" Width="260">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Grid.Column="0"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tìm IP, tên máy, OS, DB, người KT..."
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     BorderThickness="0" VerticalAlignment="Center" FontSize="12"
                                     TextChanged="TxtSearch_TextChanged"
                                     KeyDown="TxtSearch_KeyDown"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="20" Height="20" Padding="0" Margin="2,0,0,0"
                                    Visibility="Collapsed" Click="BtnClearSearch_Click">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14"
                                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN DATAGRID -->
        <materialDesign:Card Grid.Row="1" Padding="6">
            <DataGrid x:Name="GridVms" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                      Background="{DynamicResource AppCardBackgroundBrush}"
                      Foreground="{DynamicResource AppPrimaryTextBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="GridVms_MouseDoubleClick"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- CHECKBOX CHỌN MÁY ẢO ĐỂ XÓA (Ở ĐẦU DÒNG) -->
                    <DataGridTemplateColumn Width="60" MinWidth="55" MaxWidth="70" CanUserResize="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="ChkSelectAll" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsThreeState="True" ToolTip="Chọn tất cả / Bỏ chọn tất cả"
                                      Click="ChkSelectAll_Click" Cursor="Hand">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="RowCheckBox_Click" Cursor="Hand">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PLAY (CONNECT RDP) BUTTON -->
                    <DataGridTemplateColumn Header="Play" Width="85" MinWidth="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AppSuccessButtonStyle}"
                                        Width="68" Height="26" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Click="BtnPlayRdp_Click"
                                        ToolTip="Mở Remote Desktop (Play)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Play" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- IP WITH COPY BUTTON & FILTER -->
                    <DataGridTemplateColumn Width="Auto" MinWidth="160">
                        <DataGridTemplateColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Ip" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Ip" ToolTip="Lọc Địa Chỉ IP">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Địa Chỉ IP" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            DockPanel.Dock="Right" Width="22" Height="22" Padding="0"
                                            Click="BtnCopyIp_Click" ToolTip="Sao chép IP">
                                        <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                                 Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                    </Button>
                                    <TextBlock Text="{Binding Ip}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TÊN MÁY -->
                    <DataGridTextColumn Binding="{Binding MachineName}" Width="Auto" MinWidth="160" FontWeight="SemiBold">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_MachineName" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="MachineName" ToolTip="Lọc Tên Máy">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Tên Máy" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- DOMAIN/WORKGROUP -->
                    <DataGridTextColumn Binding="{Binding DomainOrWorkgroup}" Width="Auto" MinWidth="150">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_DomainOrWorkgroup" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="DomainOrWorkgroup" ToolTip="Lọc Domain/Workgroup">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Domain/Workgroup" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- HỆ ĐIỀU HÀNH -->
                    <DataGridTextColumn Binding="{Binding Os}" Width="Auto" MinWidth="240">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Os" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Os" ToolTip="Lọc Hệ Điều Hành">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Hệ Điều Hành" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- USER -->
                    <DataGridTextColumn Binding="{Binding Username}" Width="Auto" MinWidth="110">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Username" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Username" ToolTip="Lọc User">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="User" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- PASSWORD WITH MASK TOGGLE & COPY -->
                    <DataGridTemplateColumn Header="Password" Width="Auto" MinWidth="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0" Margin="2,0"
                                                Click="BtnTogglePassword_Click" ToolTip="Ẩn / Hiện mật khẩu">
                                            <materialDesign:PackIcon Kind="{Binding IsPasswordMasked, Converter={x:Null}, FallbackValue=EyeOutline}"
                                                                     Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Width="20" Height="20" Padding="0"
                                                Click="BtnCopyPass_Click" ToolTip="Sao chép Password">
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13"
                                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPassword}" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,4,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TNS -->
                    <DataGridTextColumn Binding="{Binding Tns}" Width="Auto" MinWidth="120">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Tns" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Tns" ToolTip="Lọc TNS">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="TNS" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- DATABASE NAME -->
                    <DataGridTextColumn Binding="{Binding DatabaseName}" Width="Auto" MinWidth="135">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_DatabaseName" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="DatabaseName" ToolTip="Lọc Database Name">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Database Name" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- ORACLE VER -->
                    <DataGridTextColumn Binding="{Binding OracleVersion}" Width="Auto" MinWidth="110">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_OracleVersion" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="OracleVersion" ToolTip="Lọc Oracle Ver">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Oracle Ver" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- NGƯỜI KT -->
                    <DataGridTextColumn Binding="{Binding Tester}" Width="Auto" MinWidth="105">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Tester" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Tester" ToolTip="Lọc Người KT">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Người KT" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- GHI CHÚ -->
                    <DataGridTextColumn Binding="{Binding Notes}" Width="Auto" MinWidth="180">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_Notes" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="Notes" ToolTip="Lọc Ghi Chú">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Ghi Chú" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- NGÀY HẾT HẠN -->
                    <DataGridTextColumn Binding="{Binding ExpirationDate}" Width="Auto" MinWidth="125">
                        <DataGridTextColumn.Header>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnFilter_ExpirationDate" Style="{StaticResource MaterialDesignFlatButton}"
                                        DockPanel.Dock="Right" Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                        Click="BtnColumnFilter_Click" Tag="ExpirationDate" ToolTip="Lọc Ngày Hết Hạn">
                                    <materialDesign:PackIcon Kind="FilterOutline" Width="12" Height="12"
                                                             Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                </Button>
                                <TextBlock Text="Ngày Hết Hạn" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- EDIT & DELETE BUTTONS -->
                    <DataGridTemplateColumn Header="Thao Tác" Width="85" MinWidth="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                            Click="BtnEdit_Click" ToolTip="Chỉnh sửa máy ảo">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Width="24" Height="24" Padding="0"
                                            Click="BtnDelete_Click" ToolTip="Xóa máy ảo này">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="0,8,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtSummary" Text="Tổng cộng: 0 máy ảo" FontWeight="SemiBold"
                           FontSize="12" Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Nháy đúp vào dòng hoặc nhấn nút Play để mở Remote Desktop"
                           HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- EXCEL-STYLE COLUMN FILTER POPUP -->
        <Popup x:Name="FilterPopup" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="Bottom">
            <materialDesign:Card Margin="6" Padding="10" Width="270" MaxHeight="430"
                                 Background="{DynamicResource AppCardBackgroundBrush}"
                                 BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                                 BorderThickness="1"
                                 materialDesign:ElevationAssist.Elevation="Dp6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Title and Close -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Width="22" Height="22" Padding="0" Click="BtnCloseFilterPopup_Click">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Filter" Width="15" Height="15"
                                                     Foreground="{DynamicResource AppPrimaryButtonBackground}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtFilterColumnTitle" Text="Lọc Cột" FontWeight="Bold"
                                       FontSize="12" Foreground="{DynamicResource AppPrimaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Quick Actions: Sort & Clear Filter for this column -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSubtlePanelBackgroundBrush}"
                            CornerRadius="4" Padding="4,3" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BtnSortAsc" Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="5,0" Height="22" Margin="0,0,3,0" Click="BtnSortAsc_Click"
                                        ToolTip="Sắp xếp tăng dần A-Z">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SortAlphabeticalAscending" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="A-Z" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSortDesc" Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="5,0" Height="22" Click="BtnSortDesc_Click"
                                        ToolTip="Sắp xếp giảm dần Z-A">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SortAlphabeticalDescending" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Z-A" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button x:Name="BtnClearColumnFilter" Style="{StaticResource MaterialDesignFlatButton}"
                                    Padding="5,0" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Click="BtnClearColumnFilter_Click" ToolTip="Xóa lọc trên cột này">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterOffOutline" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,3,0"
                                                             Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                    <TextBlock Text="Bỏ lọc cột" FontSize="11" Foreground="{DynamicResource AppDangerButtonBackground}"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Search Box within Popup -->
                    <Border Grid.Row="2" Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" Grid.Column="0"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TxtFilterSearch" Grid.Column="1"
                                     materialDesign:HintAssist.Hint="Tìm giá trị..."
                                     BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     TextChanged="TxtFilterSearch_TextChanged"/>
                            <Button x:Name="BtnClearFilterSearch" Grid.Column="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="16" Height="16" Padding="0" Visibility="Collapsed"
                                    Click="BtnClearFilterSearch_Click">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="12" Height="12"
                                                         Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filter Items Checklist -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2" MaxHeight="190">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <CheckBox x:Name="ChkFilterSelectAll" Content="(Chọn tất cả)"
                                          Margin="6,4" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand"
                                          IsThreeState="True" Click="ChkFilterSelectAll_Click"/>
                                <Separator Margin="4,2"/>
                                <ItemsControl x:Name="ListFilterItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="6,2" FontSize="11.5" Cursor="Hand"
                                                      Click="FilterItemCheckBox_Click">
                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Action Buttons -->
                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtFilterItemCount" Text="0 mục" FontSize="11"
                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                    Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                    Content="Hủy" Click="BtnCloseFilterPopup_Click"/>
                            <Button Style="{StaticResource AppPrimaryButtonStyle}"
                                    Height="26" Padding="12,0" FontSize="11"
                                    Content="Áp Dụng" Click="BtnApplyFilter_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </materialDesign:Card>
        </Popup>
    </Grid>
</UserControl>
