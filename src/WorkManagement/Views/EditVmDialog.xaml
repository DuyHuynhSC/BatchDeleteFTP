<Window x:Class="WorkManagement.Views.EditVmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thông Tin Máy Ảo"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon x:Name="IconHeader" Kind="DesktopTowerMonitor" Width="26" Height="26"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Thêm Máy Ảo Mới" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Quản lý thông tin kết nối Remote Desktop và Oracle Database" FontSize="11" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- FORM CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT 1: THÔNG TIN SERVER & RDP -->
                    <materialDesign:Card Grid.Column="0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN TRUY CẬP RDP" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNo" Grid.Column="0" Margin="0,0,6,0"
                                         materialDesign:HintAssist.Hint="STT / No"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                <TextBox x:Name="TxtIp" Grid.Column="1"
                                         materialDesign:HintAssist.Hint="Địa chỉ IP (*)"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         FontWeight="SemiBold"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            </Grid>

                            <TextBox x:Name="TxtMachineName" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Tên máy (Host name)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtDomain" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Domain / Workgroup"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtOs" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Hệ điều hành (OS)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtUsername" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Username (vd: Administrator)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPassword" Grid.Column="0"
                                         materialDesign:HintAssist.Hint="Password (*)"
                                         Foreground="{DynamicResource AppPrimaryTextBrush}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            </Grid>

                            <TextBox x:Name="TxtExpirationDate" Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="Ngày hết hạn (vd: Vô hạn, 2026/12/31)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- CỘT 2: THÔNG TIN DATABASE & GHI CHÚ -->
                    <materialDesign:Card Grid.Column="2" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="DATABASE &amp; QUẢN TRỊ" FontWeight="Bold" FontSize="12"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}" Margin="0,0,0,10"/>

                            <TextBox x:Name="TxtTns" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="TNS Name"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtDatabaseName" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Tên Database (Database Name)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtOracleVersion" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Phiên bản Oracle (Version)"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtTester" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Người kiểm tra / Quản lý"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                            <TextBox x:Name="TxtNotes" Margin="0,0,0,4"
                                     materialDesign:HintAssist.Hint="Ghi chú (Notes)"
                                     AcceptsReturn="True" Height="70"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12">
            <DockPanel>
                <Button x:Name="BtnTestRdp" Style="{StaticResource AppSuccessButtonStyle}"
                        DockPanel.Dock="Left" Height="34" Padding="12,0" Click="BtnTestRdp_Click"
                        ToolTip="Thử mở Remote Desktop ngay với thông tin hiện tại">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thử mở RDP" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="34" Width="90" Margin="0,0,8,0" Click="BtnCancel_Click"
                            Content="Hủy"/>
                    <Button x:Name="BtnSave" Style="{StaticResource AppPrimaryButtonStyle}"
                            Height="34" Width="110" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Lưu lại" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
