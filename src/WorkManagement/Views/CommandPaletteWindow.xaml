<Window x:Class="WorkManagement.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Command Palette (Ctrl + K)"
        Height="470" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource AppCardBackgroundBrush}"
            BorderBrush="{DynamicResource AppPrimaryButtonBackground}"
            BorderThickness="1.5"
            CornerRadius="10"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.38" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SEARCH INPUT HEADER -->
            <Border Grid.Row="0" Padding="14,12" BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0" Kind="ConsoleLine" Width="22" Height="22"
                                             Foreground="{DynamicResource AppPrimaryButtonBackground}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox x:Name="TxtQuery" Grid.Column="1"
                             FontSize="15" FontWeight="SemiBold"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource AppPrimaryTextBrush}"
                             materialDesign:HintAssist.Hint="Gõ tên máy ảo (mở RDP), tên dự án, FTP profile hoặc lệnh..."
                             VerticalContentAlignment="Center"
                             TextChanged="TxtQuery_TextChanged"/>

                    <Border Grid.Column="2" Background="{DynamicResource AppSubtlePanelBackgroundBrush}"
                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="ESC để đóng" FontSize="10.5" Opacity="0.7" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RESULTS LIST -->
            <ListBox x:Name="LstResults" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LstResults_MouseDoubleClick"
                     Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AppSubtlePanelBackgroundBrush}"
                                    CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding CategoryBadge}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AppSectionIconBrush}"/>
                            </Border>

                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="20" Height="20"
                                                     Foreground="{DynamicResource AppSectionIconBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.75"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- FOOTER HINTS -->
            <Border Grid.Row="2" Background="{DynamicResource AppSubtlePanelBackgroundBrush}"
                    CornerRadius="0,0,9,9" Padding="14,7" BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="TxtResultCount" Text="0 kết quả" FontSize="11" Opacity="0.75"
                               Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="↑↓ Di chuyển   •   Enter: Thực thi ngay   •   Ctrl+K: Mở nhanh mọi lúc"
                               FontSize="11" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
