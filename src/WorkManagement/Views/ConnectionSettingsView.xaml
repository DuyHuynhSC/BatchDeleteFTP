<UserControl x:Class="WorkManagement.Views.ConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <!-- Body ScrollViewer -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
        <StackPanel MaxWidth="1150" HorizontalAlignment="Stretch">
            <!-- SECTION 0: SITE PROFILE MANAGEMENT -->
            <materialDesign:Card Margin="0,0,0,12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="20" Height="20" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Site Profile:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox x:Name="CboProfiles" Grid.Column="1" IsEditable="True"
                              VerticalContentAlignment="Center" Margin="0,0,12,0"
                              materialDesign:HintAssist.Hint="Chọn hoặc nhập tên Profile..."
                              SelectionChanged="CboProfiles_SelectionChanged"
                              ToolTip="Chọn Profile đã lưu hoặc nhập tên Profile mới để lưu"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnNewProfile" Style="{StaticResource AppTealButtonStyle}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" Click="BtnNewProfile_Click"
                                ToolTip="Khởi tạo một Profile mới">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlusCircleOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Tạo Mới" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaveProfile" Style="{StaticResource AppTealButtonStyle}"
                                Height="32" Padding="12,0" Margin="0,0,6,0" Click="BtnSaveProfile_Click"
                                ToolTip="Lưu thông tin đang nhập vào Profile này">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Lưu Profile" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDeleteProfile" Style="{StaticResource AppDangerButtonStyle}"
                                Height="32" Padding="12,0" Click="BtnDeleteProfile_Click"
                                ToolTip="Xóa Profile đang chọn">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Xóa" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- SECTION 1: FTP CONNECTION CARD -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="ServerSecurity" Width="20" Height="20" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="1. Thông tin Kết nối FTP (FTPS / TLS)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Host & Port & Encryption -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.8*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtHost" Grid.Column="0" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="FTP Host (VD: ftp.domain.com)"
                                 VerticalContentAlignment="Center"/>

                        <TextBox x:Name="TxtPort" Grid.Column="1" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Port (VD: 6021 / 21)"
                                 VerticalContentAlignment="Center"/>

                        <ComboBox x:Name="CboEncryption" Grid.Column="2" SelectedIndex="0"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  materialDesign:HintAssist.Hint="Phương thức Mã hóa (TLS)"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Implicit (FTP over TLS)" Tag="Implicit"/>
                            <ComboBoxItem Content="Explicit (FTP over TLS)" Tag="Explicit"/>
                        </ComboBox>
                    </Grid>

                    <!-- Username, Password & Retention -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtUser" Grid.Column="0" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="FTP Username"
                                 VerticalContentAlignment="Center"/>

                        <Grid Grid.Column="1" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtPassword" Grid.Column="0"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="FTP Password"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtPasswordRevealed" Grid.Column="0" Visibility="Collapsed"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="FTP Password"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="28" Height="28" Padding="0" Margin="4,0,0,2" VerticalAlignment="Bottom"
                                    Click="BtnToggleFtpPassword_Click" ToolTip="Ẩn / Hiện FTP Password">
                                <materialDesign:PackIcon x:Name="IconFtpPassEye" Kind="EyeOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <TextBox x:Name="TxtRetentionDays" Grid.Column="2"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Giữ lại (+N ngày)"
                                 ToolTip="Xóa các file có Ngày hệ thống &gt; Ngày Upload + N ngày"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- SECTION 2: PROXY SETTINGS CARD -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldSyncOutline" Width="20" Height="20" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="2. Cấu hình Proxy Vượt Tường Lửa" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkUseProxy" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                  Content="Kích hoạt sử dụng Proxy" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid IsEnabled="{Binding ElementName=ChkUseProxy, Path=IsChecked}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtProxyHost" Grid.Column="0" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Địa chỉ Proxy Server (VD: proxy.company.com)"
                                 VerticalContentAlignment="Center"/>

                        <TextBox x:Name="TxtProxyPort" Grid.Column="1" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Proxy Port (8080)"
                                 VerticalContentAlignment="Center"/>

                        <TextBox x:Name="TxtProxyUser" Grid.Column="2" Margin="0,0,12,0"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Proxy User (nếu có)"
                                 VerticalContentAlignment="Center"/>

                        <Grid Grid.Column="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtProxyPassword" Grid.Column="0"
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                         materialDesign:HintAssist.Hint="Proxy Password (nếu có)"
                                         VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtProxyPasswordRevealed" Grid.Column="0" Visibility="Collapsed"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Proxy Password (nếu có)"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="28" Height="28" Padding="0" Margin="4,0,0,2" VerticalAlignment="Bottom"
                                    Click="BtnToggleProxyPassword_Click" ToolTip="Ẩn / Hiện Proxy Password">
                                <materialDesign:PackIcon x:Name="IconProxyPassEye" Kind="EyeOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- SECTION 3: REMOTE PATHS & BACKUP CARD -->
            <materialDesign:Card Margin="0,0,0,12" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="FolderSyncOutline" Width="20" Height="20" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="3. Thư mục FTP &amp; Vị trí Sao lưu Local (Backup)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Remote Paths -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderNetworkOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Remote Paths (;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnBrowseRemote" DockPanel.Dock="Right"
                                    Style="{StaticResource AppOutlinedButtonStyle}"
                                    Height="32" Padding="12,0" Margin="8,0,0,0"
                                    Click="BtnBrowseRemote_Click"
                                    ToolTip="Duyệt cây thư mục trực tiếp trên máy chủ FTP">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderSearchOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chọn FTP..." VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="TxtRemotePaths"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Danh sách thư mục FTP cách nhau bởi dấu chấm phẩy (;)"
                                     ToolTip="Nhiều đường dẫn ngăn cách bởi dấu chấm phẩy (;), ví dụ: /FolderA;/FolderB"/>
                        </DockPanel>
                    </Grid>

                    <Separator Opacity="0.2" Margin="0,0,0,10"/>

                    <!-- ADVANCED FILTER RULES (WHITELIST, EXTENSIONS, MIN SIZE) -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="FilterCogOutline" Width="17" Height="17" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Bộ lọc Quét &amp; Xóa Nâng Cao (Tùy chọn):" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtExcludePatterns" Grid.Column="0" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Loại trừ an toàn / Không xóa (VD: *.keep;readme.txt;/master/)"
                                     ToolTip="Danh sách tên file, wildcard (*.keep) hoặc thư mục con không bao giờ bị xóa, phân cách bởi dấu ;"
                                     VerticalContentAlignment="Center"/>

                            <TextBox x:Name="TxtIncludeExtensions" Grid.Column="1" Margin="0,0,12,0"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Chỉ xóa đuôi file (VD: .zip;.bak;.dmp - để trống = tất cả)"
                                     ToolTip="Nếu nhập, chỉ các file có phần mở rộng nằm trong danh sách này mới bị đưa vào diện xóa"
                                     VerticalContentAlignment="Center"/>

                            <TextBox x:Name="TxtMinFileSizeMb" Grid.Column="2"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Dung lượng tối thiểu (MB)"
                                     ToolTip="Chỉ xóa các file có dung lượng lớn hơn hoặc bằng số MB này (Nhập 0 để không giới hạn)"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <Separator Opacity="0.2" Margin="0,0,0,10"/>

                    <!-- Local Backup Path -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkEnableBackup" Grid.Column="0" Content="Sao lưu trước xóa"
                                  VerticalAlignment="Center" FontWeight="SemiBold"/>

                        <DockPanel Grid.Column="1" VerticalAlignment="Center"
                                   IsEnabled="{Binding ElementName=ChkEnableBackup, Path=IsChecked}">
                            <Button x:Name="BtnBrowseLocalBackup" DockPanel.Dock="Right"
                                    Style="{StaticResource AppOutlinedButtonStyle}"
                                    Height="32" Padding="12,0" Margin="8,0,0,0"
                                    Click="BtnBrowseLocalBackup_Click"
                                    ToolTip="Chọn thư mục lưu trữ file backup trên máy tính cá nhân">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chọn Local..." VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <TextBox x:Name="TxtLocalBackupPath"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Đường dẫn thư mục lưu bản sao lưu trên máy tính"
                                     ToolTip="Thư mục sao lưu file trước khi thực hiện xóa khỏi FTP"/>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ACTION BUTTONS: NẰM SÁT NGAY DƯỚI FORM NHẬP THÔNG TIN -->
            <Border Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <!-- Test Connection Button (Left) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button x:Name="BtnTestConnection" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="36" Padding="14,0" Click="BtnTestConnection_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtTestConnectionLabel" Text="Kiểm Tra Kết Nối" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="80" Height="4"
                                     Visibility="Collapsed" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Save & Apply (Right) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnSaveAndApply" Style="{StaticResource AppPrimaryButtonStyle}"
                                Height="36" Padding="20,0" Click="BtnSaveAndApply_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu &amp; Áp Dụng Cấu Hình" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
